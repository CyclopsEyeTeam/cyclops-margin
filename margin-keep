#!/usr/bin/env bash
# margin-keep — keep one line in Wonder's margin, across sessions.
#
#   margin-keep "the line worth keeping"   keep it (shown in the pane's box)
#   margin-keep                            show what is kept, if anything
#   margin-keep --clear                    let it go
#
# One line only: a margin keeps a line, not a journal. Stored as plain text
# at ${MARGIN_KEPT:-~/.local/share/wonder-margin/kept.txt}; the sidecar pane
# only ever reads that file.
set -uo pipefail

KEPT="${MARGIN_KEPT:-${HOME:-}/.local/share/wonder-margin/kept.txt}"

# Display and storage never carry terminal control: control characters
# (carriage return included), invisible bidi/zero-width characters, and
# the earned `✓` are stripped on the way in, and again on the way out (in
# case the file was written by something else), so the show-back cannot
# inject into your terminal. Python does the Unicode work when present;
# the tr fallback still strips every ASCII control.
sanitize() {
  if command -v python3 >/dev/null 2>&1; then
    python3 -c '
import sys
invis = {0x200B, 0x200C, 0x200D, 0x200E, 0x200F, 0x202A, 0x202B, 0x202C,
         0x202D, 0x202E, 0x2060, 0x2061, 0x2062, 0x2063, 0x2064, 0x00AD, 0xFEFF}
data = sys.stdin.buffer.read().decode("utf-8", "ignore")
data = data.replace("\n", " ").replace("\t", " ").replace("\r", " ")
out = "".join(ch for ch in data
              if ord(ch) >= 32 and not 127 <= ord(ch) < 160
              and ord(ch) not in invis and ch != "✓")
sys.stdout.write(out)
'
  else
    tr '\n\t\r' ' ' | tr -d '\001-\010\013\014\016-\037\177'
  fi
}

usage() {
  cat <<'EOF'
│ margin-keep — keep one line in Wonder's margin, across sessions.
│
│   margin-keep "the line worth keeping"   keep it (shown in the pane's box)
│   margin-keep --stdin                    keep a line fed on stdin
│   margin-keep                            show what is kept, if anything
│   margin-keep --clear                    let it go
│   margin-keep --help                     this text (keeps nothing)
EOF
}

case "${1:-}" in
  --help|-h)
    if [ $# -gt 1 ]; then
      printf '│ ! %s takes no further words — nothing was kept.\n' "$1" >&2
      exit 2
    fi
    usage
    ;;
  --clear|--forget)
    if [ $# -gt 1 ]; then
      printf '│ ! %s takes no further words — nothing was let go.\n' "$1" >&2
      exit 2
    fi
    if ! rm -f "$KEPT" 2>/dev/null; then
      printf '│ ! could not remove %s — nothing was let go.\n' "$KEPT" >&2
      exit 1
    fi
    printf '│ · kept line let go.\n'
    ;;
  --stdin)
    if [ $# -gt 1 ]; then
      printf '│ ! %s takes no further words — nothing was kept.\n' "$1" >&2
      exit 2
    fi
    # Keep a line fed on stdin (the /margin command uses this with a
    # temp file, so the line never enters a shell command string).
    LINE="$(cat | sanitize)"
    LINE="${LINE#"${LINE%%[![:space:]]*}"}"
    LINE="${LINE%"${LINE##*[![:space:]]}"}"
    if [ -z "$LINE" ]; then
      printf '│ ! nothing to keep — the line was blank.\n' >&2
      exit 1
    fi
    if [ -e "$KEPT" ] && [ ! -f "$KEPT" ]; then
      printf '│ ! could not write %s — the line was NOT kept.\n' "$KEPT" >&2
      exit 1
    fi
    KEPT_DIR="$(dirname "$KEPT")"
    if ! mkdir -p "$KEPT_DIR" 2>/dev/null; then
      printf '│ ! could not write %s — the line was NOT kept.\n' "$KEPT" >&2
      exit 1
    fi
    TMP="$(mktemp "$KEPT_DIR/.kept.XXXXXX" 2>/dev/null)" || {
      printf '│ ! could not write %s — the line was NOT kept.\n' "$KEPT" >&2
      exit 1
    }
    if ! printf '%s\n' "$LINE" > "$TMP" 2>/dev/null || ! mv -f "$TMP" "$KEPT" 2>/dev/null; then
      rm -f "$TMP" 2>/dev/null || true
      printf '│ ! could not write %s — the line was NOT kept.\n' "$KEPT" >&2
      exit 1
    fi
    printf '│ kept · “%s”\n' "$LINE"
    ;;
  "")
    if [ -f "$KEPT" ] && [ -s "$KEPT" ]; then
      printf '│ kept · “%s”\n' "$(head -n 1 "$KEPT" | sanitize)"
    else
      printf '│ · nothing kept yet — margin-keep "a line worth keeping"\n'
    fi
    ;;
  --*)
    printf '│ ! unknown flag: %s — nothing was kept.\n' "$1" >&2
    usage >&2
    exit 2
    ;;
  *)
    # One kept line is one line: flatten any embedded breaks/tabs to
    # spaces, strip control characters, and trim — so what is confirmed
    # is exactly what the pane will show.
    LINE="$(printf '%s' "$*" | sanitize)"
    LINE="${LINE#"${LINE%%[![:space:]]*}"}"
    LINE="${LINE%"${LINE##*[![:space:]]}"}"
    if [ -z "$LINE" ]; then
      printf '│ ! nothing to keep — the line was blank.\n' >&2
      exit 1
    fi
    # The confirmation is earned: it prints only after the write lands.
    # The write itself is a temp file renamed over the target, so a
    # symlink at the kept path is replaced — never followed into
    # truncating whatever it happened to point at.
    if [ -e "$KEPT" ] && [ ! -f "$KEPT" ]; then
      printf '│ ! could not write %s — the line was NOT kept.\n' "$KEPT" >&2
      exit 1
    fi
    KEPT_DIR="$(dirname "$KEPT")"
    if ! mkdir -p "$KEPT_DIR" 2>/dev/null; then
      printf '│ ! could not write %s — the line was NOT kept.\n' "$KEPT" >&2
      exit 1
    fi
    TMP="$(mktemp "$KEPT_DIR/.kept.XXXXXX" 2>/dev/null)" || {
      printf '│ ! could not write %s — the line was NOT kept.\n' "$KEPT" >&2
      exit 1
    }
    if ! printf '%s\n' "$LINE" > "$TMP" 2>/dev/null || ! mv -f "$TMP" "$KEPT" 2>/dev/null; then
      rm -f "$TMP" 2>/dev/null || true
      printf '│ ! could not write %s — the line was NOT kept.\n' "$KEPT" >&2
      exit 1
    fi
    printf '│ kept · “%s”\n' "$LINE"
    ;;
esac
