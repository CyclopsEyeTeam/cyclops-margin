#!/usr/bin/env bash
# muse-margin — Muse with Wonder in the Margin beside it.
#
#   muse-margin                 side pane (default)
#   muse-margin --top           margin along the top
#   muse-margin side|top        same, Prism-style positional
#   muse-margin [muse args…]  everything else passes through to `muse`
#
# The wrapper owns the tmux layout; `muse` runs unchanged on the left.
# Overrides: MUSE_BIN, MARGIN_PANE, TMUX_BIN, MARGIN_WIDTH (42), MARGIN_HEIGHT (16)
set -uo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"

MUSE_BIN="${MUSE_BIN:-$(command -v muse || echo "${HOME:-}/.local/bin/muse")}"
MARGIN_PANE="${MARGIN_PANE:-$SCRIPT_DIR/margin-pane}"
TMUX_BIN="${TMUX_BIN:-$(command -v tmux || true)}"
LAYOUT="side"
[[ "$(basename "${BASH_SOURCE[0]}")" == *margintop* ]] && LAYOUT="top"

if [ "${1:-}" = "--margin-help" ] || { [ "${1:-}" = "--help" ] && [ $# -eq 1 ]; }; then
  cat <<'EOF'
│ muse-margin — Muse with Wonder in the Margin beside it
│
│   muse-margin                 side pane (default)
│   muse-margin --margin side   same, spelled out
│   muse-margin --margin top    margin along the top (or: muse-margintop)
│   muse-margin [muse args…]  everything else passes through to muse
│
│ Env: MUSE_BIN, MARGIN_PANE, TMUX_BIN, MARGIN_WIDTH (42), MARGIN_HEIGHT (16),
│      MARGIN_TMUX_STATUS=1 to keep the tmux status bar.
│ See README.md in the wonder-margin folder for install and the muse shim.
EOF
  exit 0
fi

# Layout spellings are honoured in leading position only. The moment a
# real Muse argument appears, everything after it is Muse's — including
# any `--margin` meant for Muse itself (e.g. `exec --margin side hi`).
FILTERED_ARGS=()
LEADING=1
while [ $# -gt 0 ]; do
  arg="$1"
  if [ "$LEADING" = "1" ]; then
    case "$arg" in
      --) FILTERED_ARGS+=("$1"); shift; FILTERED_ARGS+=("$@"); break ;;
      --margin-side|--side) LAYOUT="side"; shift; continue ;;
      --margin-top|--top) LAYOUT="top"; shift; continue ;;
      --margin=side) LAYOUT="side"; shift; continue ;;
      --margin=top) LAYOUT="top"; shift; continue ;;
      --margin)
        if [ $# -ge 2 ] && { [ "$2" = "side" ] || [ "$2" = "top" ]; }; then
          LAYOUT="$2"; shift 2
        else
          LAYOUT="side"; shift
        fi; continue ;;
      side|top) LAYOUT="$arg"; shift; continue ;;
    esac
  fi
  LEADING=0
  FILTERED_ARGS+=("$arg"); shift
done

# Pane geometry comes from the environment, so it is validated here:
# a non-numeric or zero size would make tmux refuse the split — in the
# dedicated-session path that failure would otherwise be silent.
if ! [[ "${MARGIN_WIDTH:-42}" =~ ^[0-9]+$ ]] || [ "${MARGIN_WIDTH:-42}" -eq 0 ]; then
  echo "│ ? MARGIN_WIDTH '${MARGIN_WIDTH:-}' is not a positive number — using 42." >&2
  MARGIN_WIDTH=42
fi
if ! [[ "${MARGIN_HEIGHT:-16}" =~ ^[0-9]+$ ]] || [ "${MARGIN_HEIGHT:-16}" -eq 0 ]; then
  echo "│ ? MARGIN_HEIGHT '${MARGIN_HEIGHT:-}' is not a positive number — using 16." >&2
  MARGIN_HEIGHT=16
fi
case "$MUSE_BIN" in
  */*)
    if [ ! -x "$MUSE_BIN" ]; then
      echo "│ ! muse not found or not executable: $MUSE_BIN" >&2
      exit 127
    fi ;;
  *)
    if ! command -v "$MUSE_BIN" >/dev/null 2>&1; then
      echo "│ ! muse not found on PATH: $MUSE_BIN" >&2
      exit 127
    fi ;;
esac

# tmux panes inherit the *session* environment, never this shell's: a
# server started earlier (or a variable exported just for this launch)
# would otherwise give the pane a stale HOME and silently drop every
# MARGIN_*/XDG_* override. Forward what the sidecar actually reads —
# via `env`, so no tmux-version or pane-shell syntax is involved.
ENV_FWD=""
for _v in HOME XDG_DATA_HOME XDG_STATE_HOME MARGIN_KEPT \
          MARGIN_SIDEVIEW_TIPS MARGIN_SIDEVIEW_BIN \
          CYCLOPS_SIDEVIEW_MUSE_DATA_DIR; do
  [ -n "${!_v:-}" ] && ENV_FWD="$ENV_FWD $_v=$(printf '%q' "${!_v}")"
done
[ -n "$ENV_FWD" ] && ENV_FWD="env$ENV_FWD "
MARGIN_CMD="${ENV_FWD}$(printf '%q' "$MARGIN_PANE")"

# Non-interactive (piped, scripts, dumb terminal): pass straight through.
# (${arr[@]+...} is the bash 3.2-safe empty-array expansion under `set -u`.)
if [ ! -t 0 ] || [ ! -t 1 ] || [ "${TERM:-}" = "dumb" ]; then
  exec "$MUSE_BIN" ${FILTERED_ARGS[@]+"${FILTERED_ARGS[@]}"}
fi

# No tmux: Muse alone, honestly without me beside it.
if [ -z "$TMUX_BIN" ] || [ ! -x "$TMUX_BIN" ]; then
  echo "│ ? tmux not found — Muse alone; the margin needs tmux for a side pane." >&2
  exec "$MUSE_BIN" ${FILTERED_ARGS[@]+"${FILTERED_ARGS[@]}"}
fi

# No pane: say so and run Muse alone rather than opening a tmux
# session whose margin dies instantly and silently.
_pane_ok=1
case "$MARGIN_PANE" in
  */*) [ -x "$MARGIN_PANE" ] || _pane_ok=0 ;;
  *) command -v "$MARGIN_PANE" >/dev/null 2>&1 || _pane_ok=0 ;;
esac
if [ "$_pane_ok" != "1" ]; then
  echo "│ ? margin pane not found or not executable: $MARGIN_PANE — Muse alone." >&2
  exec "$MUSE_BIN" ${FILTERED_ARGS[@]+"${FILTERED_ARGS[@]}"}
fi

tmux_setup() {
  # Session-scoped only, on the session we are joining. Never -g/-s:
  # the user's server keeps its own settings throughout. The joined
  # session's own two values are saved by the caller and restored on
  # exit, so the session is also left exactly as it was found.
  "$TMUX_BIN" set-option mouse on 2>/dev/null || true
  "$TMUX_BIN" set-option history-limit 50000 2>/dev/null || true
}

tmux_restore() { # prev_mouse prev_history_limit
  if [ -n "$1" ]; then "$TMUX_BIN" set-option mouse "$1" 2>/dev/null || true
  else "$TMUX_BIN" set-option -u mouse 2>/dev/null || true; fi
  if [ -n "$2" ]; then "$TMUX_BIN" set-option history-limit "$2" 2>/dev/null || true
  else "$TMUX_BIN" set-option -u history-limit 2>/dev/null || true; fi
}

# Case 1: already inside tmux — split this window, kill only my pane on
# exit, and put the joined session's options back as they were found.
if [ -n "${TMUX:-}" ]; then
  PREV_MOUSE="$("$TMUX_BIN" show-option -qv mouse 2>/dev/null || true)"
  PREV_HIST="$("$TMUX_BIN" show-option -qv history-limit 2>/dev/null || true)"
  tmux_setup
  if [ "$LAYOUT" = "top" ]; then
    PANE_ID=$("$TMUX_BIN" split-window -b -v -l "${MARGIN_HEIGHT:-16}" -P -F "#{pane_id}" "$MARGIN_CMD" 2>/dev/null || true)
    [ -n "$PANE_ID" ] && "$TMUX_BIN" select-pane -D 2>/dev/null || true
  else
    PANE_ID=$("$TMUX_BIN" split-window -h -l "${MARGIN_WIDTH:-42}" -P -F "#{pane_id}" "$MARGIN_CMD" 2>/dev/null || true)
    [ -n "$PANE_ID" ] && "$TMUX_BIN" select-pane -L 2>/dev/null || true
  fi
  if [ -n "${PANE_ID:-}" ]; then
    cleanup() {
      tmux_restore "$PREV_MOUSE" "$PREV_HIST"
      "$TMUX_BIN" kill-pane -t "$PANE_ID" 2>/dev/null || true
    }
    trap cleanup EXIT INT TERM HUP
  else
    echo "│ ? margin pane could not open (window too small?) — Muse alone; your tmux session was left as found." >&2
    tmux_restore "$PREV_MOUSE" "$PREV_HIST"
  fi
  "$MUSE_BIN" ${FILTERED_ARGS[@]+"${FILTERED_ARGS[@]}"}
  exit $?
fi

# Case 2: dedicated tmux session — muse left, margin right (or top),
# status bar off so it feels built in, session dies when muse exits.
SESSION_NAME="muse-margin-$$"
RUNNER="$(mktemp "/tmp/muse-margin-run-XXXXXX.sh")"
chmod 700 "$RUNNER"
cat > "$RUNNER" <<'EOF'
#!/usr/bin/env bash
MUSE="$1"; SESSION="$2"; RUNNER_FILE="$3"; TMUXBIN="$4"; shift 4
"$MUSE" "$@"
CODE=$?
rm -f "$RUNNER_FILE" 2>/dev/null || true
if [ "$CODE" -ne 0 ] && [ "$CODE" -ne 130 ]; then
  printf '\n│ ! Muse exited with code %s. Press Enter to close (10s)… ' "$CODE" >&2
  read -t 10 -r _ 2>/dev/null || true
fi
"$TMUXBIN" kill-session -t "$SESSION" 2>/dev/null || true
exit "$CODE"
EOF

STATUS_OPT="off"
[ "${MARGIN_TMUX_STATUS:-0}" = "1" ] && STATUS_OPT="on"
# tmux runs this string through the user's default shell, so name bash
# explicitly: the %q quoting below is bash quoting, and dash/fish would
# mis-parse it. The runner also gets $TMUX_BIN, never a bare `tmux`.
RUNNER_CMD="${ENV_FWD}bash $(printf '%q' "$RUNNER") $(printf '%q' "$MUSE_BIN") $(printf '%q' "$SESSION_NAME") $(printf '%q' "$RUNNER") $(printf '%q' "$TMUX_BIN")"
for a in ${FILTERED_ARGS[@]+"${FILTERED_ARGS[@]}"}; do RUNNER_CMD="$RUNNER_CMD $(printf '%q' "$a")"; done

# Every option below is scoped to our own session (-t). Server-wide
# options are never touched, so the user's tmux server is left as found.
# Stepwise (not one exec chain) so a split that cannot fit is reported
# instead of silently yielding a marginless session.
# Detached creation needs the real terminal size, or splits sized
# for the user's window fail against tmux's 80x24 default. And
# destroy-unattached must NOT be set yet: it destroys a session with
# no client instantly, before attach ever happens.
_SIZE=()
[ -t 1 ] && _SIZE=(-x "$(tput cols 2>/dev/null || echo 80)" -y "$(tput lines 2>/dev/null || echo 24)")
"$TMUX_BIN" new-session -d "${_SIZE[@]}" -s "$SESSION_NAME" "$RUNNER_CMD" || {
  echo "│ ! could not create the tmux session — Muse not started." >&2
  rm -f "$RUNNER" 2>/dev/null || true
  exit 1
}
"$TMUX_BIN" set-option -t "$SESSION_NAME" mouse on 2>/dev/null || true
"$TMUX_BIN" set-option -t "$SESSION_NAME" history-limit 50000 2>/dev/null || true
"$TMUX_BIN" set-option -t "$SESSION_NAME" status "$STATUS_OPT" 2>/dev/null || true
if [ "$LAYOUT" = "top" ]; then
  if "$TMUX_BIN" split-window -b -v -l "${MARGIN_HEIGHT:-16}" -t "$SESSION_NAME" "$MARGIN_CMD" 2>/dev/null; then
    "$TMUX_BIN" select-pane -D 2>/dev/null || true
  else
    echo "│ ? margin pane could not open (window too small?) — Muse alone in this session." >&2
  fi
else
  if "$TMUX_BIN" split-window -h -l "${MARGIN_WIDTH:-42}" -t "$SESSION_NAME" "$MARGIN_CMD" 2>/dev/null; then
    "$TMUX_BIN" select-pane -L 2>/dev/null || true
  else
    echo "│ ? margin pane could not open (window too small?) — Muse alone in this session." >&2
  fi
fi
# Arm destroy-unattached only once a client is attaching, so the
# session dies on detach (as before) but never before first attach.
( sleep 1; "$TMUX_BIN" set-option -t "$SESSION_NAME" destroy-unattached on 2>/dev/null || true ) &
exec "$TMUX_BIN" attach-session -t "$SESSION_NAME"
