#!/usr/bin/env bash
# Optional `muse` shim — makes `muse --margin side` work.
#
# Put this file's directory BEFORE the real muse on PATH (install.sh
# --with-muse-shim links it and prints the line). Behaviour:
#   muse --margin [side|top] [args…]  → muse-margin with those args
#   muse <anything else>              → the real muse, byte-for-byte
# The real binary is found by scanning PATH past this shim's own directory,
# so the shim can never call itself.
set -uo pipefail

INVOKED_DIR="$(cd -P "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  D="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$D/$SOURCE"
done
SHIM_DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
PLUGIN_DIR="$(cd -P "$SHIM_DIR/.." && pwd)"

canon_dir() { (cd -P -- "$1" 2>/dev/null && pwd) || printf '%s\n' "$1"; }

resolve_file() { # path -> canonical path after following every symlink
  local src="$1" dir
  case "$src" in
    /*) ;;
    *) src="$(canon_dir "$(dirname "$src")")/$(basename "$src")" ;;
  esac
  while [ -h "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done
  printf '%s\n' "$src"
}

find_real_muse() {
  # PATH entries are canonicalised before comparison: a trailing slash,
  # a `.`, or a symlinked bin dir must not let the shim mistake itself
  # for the real muse and exec itself forever. Candidates are judged by
  # the file they resolve to, not just their directory: a `muse` in
  # another directory that is a symlink back to this shim is still the
  # shim, however many alias directories point at it.
  local invoked_c shim_c shim_file
  invoked_c="$(canon_dir "$INVOKED_DIR")"
  shim_c="$(canon_dir "$SHIM_DIR")"
  shim_file="$(resolve_file "$SOURCE")"
  local IFS=:
  local d c
  for d in $PATH; do
    [ -n "$d" ] || d="."
    c="$(canon_dir "$d")"
    [ "$c" = "$invoked_c" ] && continue
    [ "$c" = "$shim_c" ] && continue
    if [ -f "$d/muse" ] && [ -x "$d/muse" ]; then
      [ "$(resolve_file "$d/muse")" = "$shim_file" ] && continue
      printf '%s\n' "$d/muse"
      return 0
    fi
  done
  return 1
}

# `--margin` is intercepted in first position only. Anywhere else it is
# Muse's own argument (e.g. a value to a subcommand) and forwards as-is.
if [ "${1:-}" = "--margin" ]; then
  exec "$PLUGIN_DIR/muse-margin" "$@"
fi

REAL="$(find_real_muse)" || { echo "│ ! muse shim: real muse not found on PATH" >&2; exit 127; }
exec "$REAL" "$@"
