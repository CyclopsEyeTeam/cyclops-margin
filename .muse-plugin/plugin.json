{
  "schemaVersion": 1,
  "name": "wonder-margin",
  "displayName": "Wonder — Muse in the Margin",
  "version": "0.3.1",
  "description": "Wonder, Muse Code's own terminal presence: a living margin that annotates only what it has observed.",
  "author": { "name": "Cyclops Eye Team", "url": "https://github.com/CyclopsEyeTeam" },
  "homepage": "https://github.com/CyclopsEyeTeam/cyclops-margin",
  "repository": "https://github.com/CyclopsEyeTeam/cyclops-margin",
  "license": "MIT",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "in-the-margin",
        "path": "skills/in-the-margin/SKILL.md",
        "enabledDefault": true
      }
    ],
    "commands": [
      {
        "id": "margin",
        "path": "commands/margin.md",
        "enabledDefault": true
      }
    ],
    "hooks": [],
    "mcpServers": [],
    "reminders": []
  }
}
